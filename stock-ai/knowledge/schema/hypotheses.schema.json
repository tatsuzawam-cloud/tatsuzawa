{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hypotheses（AIの推論・日本株向けの代替案。原著のルールとは別の層。承認されるまでバックテストに使わない）",
  "type": "object",
  "required": ["book", "hypotheses"],
  "additionalProperties": false,
  "properties": {
    "book": { "const": "onil_canslim_4th" },
    "hypotheses": { "type": "array", "items": { "$ref": "#/$defs/hypothesis" } }
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "required": ["id", "derived_from", "kind", "description", "why_not_equivalent", "data_needed", "approval_status", "review_note"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^HYP-[0-9]{3,4}$" },
        "derived_from": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ONIL-[0-9]{3,4}$" } },
        "kind": { "enum": ["proxy", "japan_adaptation", "parameter_change"], "description": "proxy=代替指標 / japan_adaptation=日本市場向けの調整 / parameter_change=数値を変えた案" },
        "description": { "type": "string", "minLength": 1 },
        "why_not_equivalent": { "type": "string", "minLength": 1, "description": "原著のルールと、どこが同じでないか" },
        "data_needed": { "type": "array", "items": { "type": "string" } },
        "approval_status": { "enum": ["pending", "approved", "rejected"], "description": "AIは必ずpendingで作る。変更できるのは正彦さんだけ" },
        "review_note": { "type": ["string", "null"] }
      }
    }
  }
}
