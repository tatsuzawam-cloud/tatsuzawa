{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookRules（原著の記述だけを入れる層。AIの推論・日本株向けの代替は入れない）",
  "type": "object",
  "required": ["book", "rules"],
  "additionalProperties": false,
  "properties": {
    "book": { "const": "onil_canslim_4th" },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["metric", "period", "comparison_basis", "operator", "value", "value_max", "unit", "stated_as"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "minLength": 1, "description": "例: EPS成長率 / 売上高成長率 / 出来高 / 株価の高値からの下落率" },
        "period": { "type": ["string", "null"], "description": "例: 直近四半期 / 年間 / 直近3年 / 日足。本に無ければ null" },
        "comparison_basis": { "type": ["string", "null"], "description": "例: 前年同期比 / 前期比 / 50日平均比。本に無ければ null" },
        "operator": { "enum": [">=", "<=", ">", "<", "between", "=="] },
        "value": { "type": ["number", "null"], "description": "本に書かれた数値のみ。範囲の下限もここ" },
        "value_max": { "type": ["number", "null"], "description": "operatorがbetweenのときの上限。それ以外はnull" },
        "unit": { "type": ["string", "null"], "description": "例: % / 倍 / 週 / 日 / 円" },
        "stated_as": { "enum": ["explicit", "range"], "description": "explicit=本に明記された数値 / range=本が範囲や目安で書いている" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["pdf_page", "printed_page", "quote", "ocr_status"],
      "additionalProperties": false,
      "properties": {
        "pdf_page": { "type": "integer", "minimum": 1 },
        "printed_page": { "type": ["integer", "string", "null"] },
        "quote": { "type": "string", "minLength": 1, "maxLength": 30 },
        "ocr_status": { "enum": ["high", "medium", "low"] }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "status", "merged_into", "category", "canslim", "name", "book_claim", "evidence",
                   "quantifiable", "conditions", "logic", "buy_condition", "sell_condition", "exceptions",
                   "uses_financial_disclosure", "numeric_verified", "verification_status", "review_note"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ONIL-[0-9]{3,4}$", "description": "作成時に確定。以後、振り直し禁止" },
        "status": { "enum": ["active", "merged"] },
        "merged_into": { "type": ["string", "null"], "pattern": "^ONIL-[0-9]{3,4}$" },
        "category": { "enum": ["EPS", "売上高", "利益成長", "株価・出来高", "業界・市場", "機関投資家", "買いタイミング", "売却", "損切り", "例外・注意", "その他"] },
        "canslim": { "enum": ["C", "A", "N", "S", "L", "I", "M", "none"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 20 },
        "book_claim": { "type": "string", "minLength": 1, "description": "本の主張。できるだけ原文に近く" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "quantifiable": { "type": "boolean" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "description": "数値で書かれた条件のみ。数値が無ければ空配列" },
        "logic": { "enum": ["AND", "OR", null], "description": "conditionsが2件以上のとき必須。入れ子の条件は表せないのでreview_noteに書きneeds_humanにする" },
        "buy_condition": { "type": ["string", "null"] },
        "sell_condition": { "type": ["string", "null"] },
        "exceptions": { "type": ["string", "null"] },
        "uses_financial_disclosure": { "type": "boolean", "description": "決算など公表データを使う条件か。trueなら、検証時は公表日で判定する（指示書②で扱う）" },
        "numeric_verified": { "type": "boolean", "description": "conditionsの全数値を、根拠ページの画像で確認したか" },
        "verification_status": { "enum": ["not_applicable", "image_checked", "needs_human", "human_verified"] },
        "review_note": { "type": ["string", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "conditions": { "minItems": 2 } }, "required": ["conditions"] },
          "then": { "properties": { "logic": { "enum": ["AND", "OR"] } } } },
        { "if": { "properties": { "conditions": { "minItems": 1 } }, "required": ["conditions"] },
          "then": { "properties": { "quantifiable": { "const": true } } } },
        { "if": { "properties": { "status": { "const": "merged" } }, "required": ["status"] },
          "then": { "properties": { "merged_into": { "type": "string" } } } }
      ]
    }
  }
}
